# Copy this file to runtime.env and adjust the absolute paths for the server.
DB_DEFAULTS_FILE=/etc/bremerhaven-traffic/mariadb.cnf
QUEUE_DIR=/var/lib/bremerhaven-traffic/queue
LOG_DIR=/var/log/bremerhaven-traffic
STATE_DIR=/var/lib/bremerhaven-traffic/run
SESSION_DIR=/var/lib/bremerhaven-traffic/sessions
SIM_MAIL_DIR=/var/lib/bremerhaven-traffic/mail/sim
